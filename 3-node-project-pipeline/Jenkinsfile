pipeline {
    agent any
    
    environment {
        DOCKER_IMAGE = "node-project-pipeline:latest"
        DOCKER_CONTAINER = "node-project-pipeline-container"
        DOCKER_REGISTRY = "docker.io"
        DOCKER_USERNAME = "tanveersingg"
        DOCKER_REGISTRY_IMAGE = "${DOCKER_USERNAME}/node-project-pipeline:latest"
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'main', changelog: false, poll: false, url: 'https://github.com/Tanveer-rajpurohit/Jenkins.git'
            }
        }
        
        stage('Install Dependencies') {
            steps {
                dir('3-node-project-pipeline') {
                    echo "========== INSTALLING DEPENDENCIES =========="
                    sh 'npm install'
                    echo "Dependencies installed successfully"  
                }
            }
        }
        
        stage('Build') {
            steps {
                dir('3-node-project-pipeline') {
                    echo "========== BUILDING PROJECT =========="
                    sh 'npm run build'
                    echo "Build completed successfully"
                }
            }
        }
        
        stage('Test') {
            steps {
                dir('3-node-project-pipeline') {
                    echo "========== RUNNING TESTS =========="
                    sh 'npm test'
                    echo "Tests completed successfully"
                }
            }
        }
        
        stage('Start Application') {
            steps {
                dir('3-node-project-pipeline') {
                    echo "========== STARTING APPLICATION =========="
                    sh 'npm start'
                    echo "Application started successfully"
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                dir('3-node-project-pipeline') {
                    echo "========== BUILDING DOCKER IMAGE =========="
                    sh 'docker build -t ${DOCKER_IMAGE} .'
                    echo "Docker image built: ${DOCKER_IMAGE}"
                }
            }
        }
        
        stage('Run Docker Container') {
            steps {
                dir('3-node-project-pipeline') {
                    echo "========== RUNNING DOCKER CONTAINER =========="
                    sh 'docker run --rm --name ${DOCKER_CONTAINER} ${DOCKER_IMAGE}'
                    echo "Docker container executed successfully"
                }
            }
        }
        
        stage('Docker Image Tag') {
            steps {
                dir('3-node-project-pipeline') {
                    echo "========== TAGGING DOCKER IMAGE =========="
                    sh 'docker tag ${DOCKER_IMAGE} ${DOCKER_REGISTRY_IMAGE}'
                    echo "Docker image tagged: ${DOCKER_REGISTRY_IMAGE}"
                }
            }
        }
        
        stage('Docker Login') {
            steps {
                dir('3-node-project-pipeline') {
                    echo "========== LOGGING INTO DOCKER REGISTRY =========="
                    sh 'docker login -u ${DOCKER_USERNAME} -p Tanveer'
                    echo "Docker login successful"
                }
            }
        }
        
        stage('Docker Image Push') {
            steps {
                dir('3-node-project-pipeline') {
                    echo "========== PUSHING DOCKER IMAGE TO DOCKER HUB =========="
                    sh 'docker push ${DOCKER_REGISTRY_IMAGE}'
                    echo "Docker image pushed successfully: ${DOCKER_REGISTRY_IMAGE}"
                }
            }
        }
        
        stage('Clean Work Space') {
            steps {
                dir('3-node-project-pipeline') {
                    echo "========== CLEANING WORKSPACE =========="
                    cleanWs()
                    echo "Workspace cleaned successfully"
                }
            }
        }
    }
    
    post {
        always {
            echo "========== PIPELINE COMPLETED =========="
        }
        success {
            echo "✓ PIPELINE EXECUTION SUCCESSFUL"
        }
        failure {
            echo "✗ PIPELINE EXECUTION FAILED"
        }
    }
}
